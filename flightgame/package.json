{
  "name": "@desktop/flight-game",
  "version": "1.0.0",
  "description": "FCS 3D Flight Game",
  "productName": "FCS",
  "author": "cptslow123",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build:web": "tsc && vite build",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "start:app": "npm run build:web && electron .",
    "build:win": "npm run build:web && electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@types/three": "^0.172.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.cptslow123.flightgame.fcs",
    "productName": "FCS",
    "copyright": "copyright c 2026 cptslow123",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "executableName": "FCS",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "FCS-Portable-${version}-${arch}.${ext}"
    },
    "electronVersion": "37.10.3",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "electronDist": "../node_modules/electron/dist"
  }
}
